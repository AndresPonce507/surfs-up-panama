{
  "name": "surfs-up-panama",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Free community surf forecast that shows its own track record. Panama first, global by design.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run publish:surface -- --verify && astro build",
    "budget": "node scripts/check-page-weight.mjs",
    "publish:surface": "tsx src/publish/publish-static-surface.ts",
    "pipeline:capture": "tsx src/pipeline/capture-cli.ts",
    "pipeline:build": "tsx src/pipeline/run-build-cli.ts",
    "build:production": "PUBLIC_SITE_ORIGIN=https://d1dtqpd8bf3oze.cloudfront.net npm run build",
    "publish:preview": "node scripts/preview/publish-preview.mjs --target preview",
    "publish:production": "node scripts/preview/publish-preview.mjs --target production",
    "release:production": "npm run build:production && PUBLIC_SITE_ORIGIN=https://d1dtqpd8bf3oze.cloudfront.net npm run publish:production",
    "month:close": "node infra/month-close.mjs",
    "test:infra": "vitest run infra/test/guardrails.test.ts infra/test/month-close.test.ts infra/test/month-close-cli.test.ts infra/test/report-mint-wiring.test.ts infra/test/notify-wiring.test.ts infra/test/aws-write-store.dynamodb.test.ts tests/unit/aws-write-store.test.ts tests/unit/call-log-reader.test.ts tests/unit/report-write-http-adapter.test.ts",
    "synth:infra": "cdk synth --app 'npx tsx infra/bin/app.ts' --no-lookups --no-notices --quiet",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "vitest run",
    "test:at": "NODE_OPTIONS=\"--import tsx\" node scripts/run-cucumber.mjs",
    "test:ui": "npm run build && node scripts/check-ui-quality.mjs",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "ci:local": "node scripts/ci-local.mjs",
    "ci:local:fast": "node scripts/ci-local.mjs --fast",
    "smoke:build-lambda-arm64": "node scripts/smoke-build-lambda-arm64.mjs",
    "smoke:fetch-lambda-arm64": "node scripts/smoke-fetch-lambda-arm64.mjs",
    "merge:pr": "node scripts/merge-pr.mjs",
    "postinstall": "bash scripts/git-hooks/install.sh >/dev/null 2>&1 || true"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/client-dynamodb": "^3.1107.0",
    "@aws-sdk/lib-dynamodb": "^3.1107.0",
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "astro": "^7.2.0",
    "aws-cdk": "^2.1135.1",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
