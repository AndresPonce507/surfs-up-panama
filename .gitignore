*.pem
*.key

# deps and build output
node_modules/
dist/
.astro/
.ci-local-logs/

# ephemeral pipeline:build output (log/calls, pub/, manifest) — the
# committed input is data/predictions-capture/, this is scratch
.pipeline-out/
