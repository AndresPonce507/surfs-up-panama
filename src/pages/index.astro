---
// The home is the ranked-list screen for today, plus the one share action the
// top card offers. The action is composed here, in the route, so the card
// component stays a reading surface and knows nothing about WhatsApp.
//
// One data path: the message is filled from `forecast.days[0][0]`, the very
// entry RankedList paints as the big card. There is no second read of the
// published surface and no second vocabulary, so the message can never tell a
// different story than the card above it.
import RankedList from '../components/RankedList.astro';
import CopyControl from '../components/CopyControl.astro';
import ShareControls from '../components/ShareControls.astro';
import { forecast } from '../data/forecast';
import { spotById } from '../data/region';
import { stampedShareLink, whatsAppShareHref } from '../share/share-link';
import { composeLinkAnnouncement } from '../share/link-announcement';
import { selectPreviewCard } from '../share/preview-card';
import {
  composeWhatsAppCallMessage,
  type ShareDaySummary,
} from '../share/whatsapp-call-message';

const MONTHS_ES = [
  'enero',
  'febrero',
  'marzo',
  'abril',
  'mayo',
  'junio',
  'julio',
  'agosto',
  'septiembre',
  'octubre',
  'noviembre',
  'diciembre',
] as const;

/**
 * The surfing day in plain Spanish, read off the published stamp in UTC so the
 * built page says the same day on every machine. Never a raw timestamp: the
 * paste surface carries no technical text.
 */
function publishedDayEs(publishedAt: string): string {
  const [year, month, day] = publishedAt.slice(0, 10).split('-').map(Number);
  const monthName = year === undefined || month === undefined ? undefined : MONTHS_ES[month - 1];
  if (day === undefined || monthName === undefined) {
    throw new Error(`home: la mañana publicada no trae una fecha legible ("${publishedAt}")`);
  }
  return `${day} de ${monthName}`;
}

function shareSpotName(spotId: string): string {
  const spot = spotById(spotId);
  if (spot === undefined) {
    // Same contract as the card's own lookup: a day entry with no identity is
    // a broken build input. Fail the build LOUD, never paste invented data.
    throw new Error(`home: no hay identidad de spot para spot_id "${spotId}"`);
  }
  return spot.name;
}

/**
 * The five call fields are optional on a published day entry but required by
 * the share template. A morning that cannot fill them honestly stops the
 * build instead of shipping a half-written call to a group chat.
 */
function shareSummary(publishedAt: string): ShareDaySummary {
  const top = forecast.days[0][0];
  if (top === undefined) {
    throw new Error('home: la mañana publicada no trae un mejor spot para hoy');
  }
  const { size_band, wind_state, best_window, conf_level } = top;
  if (
    size_band === undefined
    || wind_state === undefined
    || best_window === undefined
    || conf_level === undefined
  ) {
    throw new Error(
      `home: el mejor spot ${top.spot_id} llega sin los campos del llamado y no se puede compartir`,
    );
  }
  return {
    fecha: publishedDayEs(publishedAt),
    spotName: shareSpotName(top.spot_id),
    scoreQ: top.score_q,
    sizeBand: size_band,
    windState: wind_state,
    windowStart: best_window.start,
    windowEnd: best_window.end,
    confidenceLevel: conf_level,
  };
}

// The absolute host has exactly one owner: `site` in astro.config.mjs. Reading
// it here means registering a real domain never touches a component.
const configuredSite = Astro.site;
if (configuredSite === undefined) {
  throw new Error('home: astro.config.mjs no declara site y el mensaje no puede llevar una dirección absoluta');
}

const homeShareSummary = shareSummary(forecast.published_at);
const stampedHomeLink = stampedShareLink(configuredSite.toString(), forecast.published_at);
const completedCall = composeWhatsAppCallMessage(
  homeShareSummary,
  stampedHomeLink,
);

const shareHref = whatsAppShareHref(completedCall);
const homePreviewSelection = selectPreviewCard({
  spot_id: forecast.days[0][0]!.spot_id,
  spot_name: homeShareSummary.spotName,
  score_q: homeShareSummary.scoreQ,
  size_band: forecast.days[0][0]!.size_band,
  size_range_m: forecast.days[0][0]!.size_range_m,
  wind_state: forecast.days[0][0]!.wind_state,
  conf_level: forecast.days[0][0]!.conf_level,
});
const previewImage = new URL(
  homePreviewSelection.kind === 'spot'
    ? `/og/${homePreviewSelection.spot_id}.jpg`
    : '/og/generica.jpg',
  configuredSite,
);
// The crawler card has the exact same morning identity as the link that
// WhatsApp opens. A new publication therefore asks the crawler for a new
// asset without contaminating the surfer's permanent canonical URL.
previewImage.search = new URL(stampedHomeLink).search;
const homeAnnouncement = composeLinkAnnouncement({
  spotName: homeShareSummary.spotName,
  score: homeShareSummary.scoreQ,
  site: configuredSite.toString(),
  image: previewImage.toString(),
});

// The A2HS hint, softened by ratified decision (2026-08-12): it renders now,
// promising only what is true today — the site one tap away, opening without
// signal. The settled avisos wording (application-architecture.md section 10)
// returns in the same change that brings the push subscribe path live; that
// restore is owned by the push lane's launch checklist
// (docs/feature/f-tell-me-when-its-worth-the-drive/launch-checklist.md).
// Until then, no aviso word may render anywhere on the public surface.
---

<RankedList locale="es" day={0} announcement={homeAnnouncement}>
  <CopyControl slot="top-card-action" call={completedCall} />
  <ShareControls
    slot="top-card-action"
    href={shareHref}
    label="Mandar el llamado por WhatsApp"
  />
  <details slot="footer-extra">
    <summary>¿Lo quieres como app?</summary>
    <p>En iPhone: Compartir, y luego Añadir a pantalla de inicio. Queda a un toque y abre aunque no haya señal.</p>
  </details>
</RankedList>
