---
interface Props {
  /** The completed call composed for the adjacent WhatsApp action. */
  call: string;
}

const { call } = Astro.props;
---

<div class="copy-control" data-copy-control>
  <button class="copy-call" type="button" data-copy-call={call}>Copiar el llamado</button>
  <p data-copy-notice aria-live="polite" hidden></p>
</div>

<script>
  import { copyCall } from '../share/copy-call';

  for (const control of document.querySelectorAll<HTMLElement>('[data-copy-control]')) {
    const button = control.querySelector<HTMLButtonElement>('[data-copy-call]');
    const notice = control.querySelector<HTMLParagraphElement>('[data-copy-notice]');
    if (button === null || notice === null) continue;

    button.addEventListener('click', async () => {
      const call = button.dataset.copyCall;
      if (call === undefined || navigator.clipboard === undefined) return;

      const outcome = await copyCall(call, (text) => navigator.clipboard.writeText(text));
      notice.textContent = outcome.notice;
      notice.dataset.copyOutcome = outcome.kind;
      notice.hidden = false;
    });
  }
</script>
