---
// Home and tomorrow are the same ranked-list screen over a different day
// array. They are separate prerendered routes, not a JS tab, so each stays
// inside its own byte budget and the refusal to forecast past tomorrow is
// visible in the information architecture itself (application-architecture.md
// section 4). Array position IS the rank; no rank field exists.
import Base from '../layouts/Base.astro';
import Confidence from './Confidence.astro';
import { forecast } from '../data/forecast';
import { spotById } from '../data/region';
import { sizeBands } from '../data/size-bands';
import { strings, type Locale } from '../i18n/strings';
import { paths } from '../i18n/routes';
import { formatUpdatedAtEs } from '../publish/display-format';

interface Props {
  locale: Locale;
  day: 0 | 1;
}

const { locale, day } = Astro.props;
const t = strings[locale];
const daySpots = forecast.days[day];
const currentPath = day === 0 ? paths.home(locale) : paths.tomorrow(locale);

function nameOf(spotId: string): string {
  const spot = spotById(spotId);
  if (spot === undefined) {
    // A day array entry with no identity is a broken build input. Fail the
    // build LOUD; never render a page with invented data (P1 contract).
    throw new Error(`RankedList: no spot identity for spot_id "${spotId}"`);
  }
  return spot.name;
}

function sizeLabel(sizeBand: (typeof daySpots)[number]['size_band']): string | undefined {
  return sizeBands.find((band) => band.value === sizeBand)?.label[locale];
}

function callFor(summary: (typeof daySpots)[number]): string {
  const call = summary.call[locale];
  if (call !== undefined) return call;
  if (locale === 'en') {
    throw new Error(
      `RankedList: English call text is missing for spot_id "${summary.spot_id}". `
      + 'The producer must publish call_en and src/data/forecast.ts must map it to call.en before /en/ can be emitted.',
    );
  }
  if (t.ranking.fallbackCall === undefined) {
    throw new Error(`RankedList: no fallback call is settled for locale "${locale}".`);
  }
  return t.ranking.fallbackCall;
}
---

<Base
  locale={locale}
  title={t.home.header}
  currentPath={currentPath}
>
  <h1>{t.home.header}</h1>
  <p>{t.home.updatedPrefix} {formatUpdatedAtEs(forecast.published_at)}</p>
  <nav>
    <a href={paths.home(locale)} aria-current={day === 0 ? 'page' : undefined}>
      {t.home.tabToday}
    </a>
    <a
      href={paths.tomorrow(locale)}
      aria-current={day === 1 ? 'page' : undefined}
    >
      {t.home.tabTomorrow}
    </a>
  </nav>
  <ol class="ranked">
    {
      daySpots.map((summary, index) => (
        <li>
          <span>{index + 1}</span>
          <a href={paths.spot(locale, summary.spot_id)}>
            {index === 0 ? t.ranking.topSpot(nameOf(summary.spot_id)) : nameOf(summary.spot_id)}
          </a>
          <strong>{summary.score_q}</strong>
          {summary.size_band !== undefined && <span>{sizeLabel(summary.size_band)}</span>}
          {summary.wind_state !== undefined && <span>{t.ranking.wind[summary.wind_state]}</span>}
          <p>{callFor(summary)}</p>
          {summary.conf_level !== undefined && <Confidence level={summary.conf_level} locale={locale} />}
        </li>
      ))
    }
  </ol>
  <footer>
    <p>{t.home.honestyFooter}</p>
  </footer>
  {t.ranking.primaryCta !== undefined && (
    <p class="home-primary">
      <a data-primary-action href={paths.spot(locale, daySpots[0]!.spot_id)}>
        {t.ranking.primaryCta}
      </a>
    </p>
  )}
</Base>
